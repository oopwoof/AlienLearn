# 复制为 .env 后填写。不填 key 时把 MOCK_LLM 设为 1，可离线跑通全流程。
MOCK_LLM=1

# DeepSeek（默认选型：国内直连、便宜、支持 JSON 输出）
# 注册与充值：https://platform.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 换厂商只改这三行，代码无需修改：
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1     LLM_MODEL=gpt-4o-mini
#   Moonshot    LLM_BASE_URL=https://api.moonshot.cn/v1    LLM_MODEL=moonshot-v1-8k
#   阿里通义     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus

# 评测脚本用的裁判模型（可与对局模型不同，通常用更强的）
JUDGE_MODEL=deepseek-chat
